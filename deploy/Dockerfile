# syntax=docker/dockerfile:1

FROM composer:2.8 AS vendor
WORKDIR /app
COPY . .
RUN composer install --no-dev --no-interaction --no-scripts --optimize-autoloader

# resources/js/{routes,actions} are generated by wayfinder, which needs a
# bootable app, so this stage carries a throwaway PHP install and .env.
FROM node:26-trixie-slim AS assets
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends \
        php8.4-cli php8.4-curl php8.4-mbstring php8.4-pgsql php8.4-xml php8.4-zip \
    && rm -rf /var/lib/apt/lists/*
COPY --from=vendor /app/vendor ./vendor
COPY . .
RUN cp .env.example .env \
    && php artisan key:generate --force \
    && php artisan wayfinder:generate --with-form
RUN npm ci && npm run build

FROM serversideup/php:8.4-fpm-nginx-v4.5.1 AS app
WORKDIR /var/www/html
USER root
RUN apt-get update && apt-get install -y --no-install-recommends supervisor \
    && rm -rf /var/lib/apt/lists/*
COPY --from=vendor /app/vendor ./vendor
COPY --from=assets /app/public/build ./public/build
COPY . .
COPY deploy/docker/supervisord.conf /etc/supervisor/conf.d/supervisord.conf
RUN mkdir -p storage/app bootstrap/cache \
    && chown -R www-data:www-data storage bootstrap/cache
